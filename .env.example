# Target Environment (dev | staging | prod | local)
TEST_ENV=dev

# Target Base URL for API under test
BASE_URL=https://api.example.com
DEV_BASE_URL=https://dev-api.example.com
STAGING_BASE_URL=https://staging-api.example.com
PROD_BASE_URL=https://api.example.com
LOCAL_BASE_URL=http://localhost:3000

# GraphQL Endpoint (optional, if testing GraphQL)
GRAPHQL_BASE_URL=https://api.example.com/graphql

# Logging Level (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO

# Request Timeout in milliseconds
REQUEST_TIMEOUT_MS=15000

# Automatic Request Retries on Transient Failures / 5xx
REQUEST_RETRIES=2
RETRY_DELAY_MS=1000

# Authentication & Credentials (optional)
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_password
AUTH_BEARER_TOKEN=your_bearer_token
API_KEY=your_api_key
API_KEY_HEADER=x-api-key

# Customizable API Endpoints Paths (optional overrides)
ENDPOINT_AUTH_LOGIN=/auth/login
ENDPOINT_AUTH_LOGOUT=/auth/logout
ENDPOINT_AUTH_REFRESH=/auth/refresh
ENDPOINT_AUTH_ME=/auth/me
ENDPOINT_HEALTH=/health
